{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "separateMinorPatch": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "homeassistant-manifest": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchPackageNames": [
        "pre-commit",
        "pyright",
        "pytest-cov",
        "ruff"
      ],
      "groupName": "python dev tools"
    },
    {
      "matchPackageNames": [
        "esbuild",
        "typescript"
      ],
      "groupName": "card build tools"
    },
    {
      "description": "The test stack pins a Home Assistant release; its frontend has to follow it in the same pull request.",
      "matchPackageNames": [
        "home-assistant-frontend",
        "pytest-homeassistant-custom-component"
      ],
      "groupName": "home assistant test stack",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ]
}
